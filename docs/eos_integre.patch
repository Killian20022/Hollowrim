+static func choisir_chemin_cfg(a_cote: String, utilisateur: String, integre: String) -> String:
+	if a_cote != "" and FileAccess.file_exists(a_cote):
+		return a_cote
+	if FileAccess.file_exists(utilisateur):
+		return utilisateur
+	if FileAccess.file_exists(integre):
+		return integre
+	return utilisateur
 
