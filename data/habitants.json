{
 "note": "Habitants anonymes du village (scripts/villageois.gd habitants(), persos/quaternius_jeu 2026-11-04). pq : corps Quaternius sali (PersosQuat.HABITANTS) ; ancien : corps Humain.creer (--persos-anciens) ; pos : (x, z) monde ; cap : degrés (0 = vers +Z) ; activite : clip au poste ; sedentaire : ne se promène pas. Répliques communes par type dans roles.",
 "roles": {
  "paysan": {
   "nom": "Paysan",
   "role": "Paysan",
   "interpellations": [
    "Le froid mord tôt, cette année.",
    "Pas le temps, l’étranger. Le bois ne se fend pas tout seul.",
    "Tu viens d’où, avec ces bottes-là ?"
   ],
   "lignes": [
    "On gratte la terre gelée et on prie pour que l’orge tienne.",
    "Depuis les lueurs du cercle, les bêtes ne dorment plus la nuit.",
    "Si tu vas vers le tertre, ne reviens pas avec ce qui y dort."
   ],
   "apres": [
    "Bon. Le travail attend.",
    "Reste près des feux à la nuit tombée.",
    "Que les dieux te gardent les pieds au sec."
   ]
  },
  "paysanne": {
   "nom": "Fermière",
   "role": "Fermière",
   "interpellations": [
    "Attention aux poules, voyageur. Enfin, à ce qu’il en reste.",
    "Encore un qui cherche la gloire. Elle ne se mange pas.",
    "Tu as faim ? Moi aussi."
   ],
   "lignes": [
    "Les loups ont pris deux brebis à l’enclos, le mois dernier.",
    "Grima dit que l’hiver sera long. Grima a toujours raison.",
    "Mon homme est parti chercher du sel à la côte. Il tarde."
   ],
   "apres": [
    "Va, va. J’ai du linge qui gèle.",
    "Si tu croises des loups, frappe le premier.",
    "La soupe sera claire, ce soir."
   ]
  },
  "chasseur": {
   "nom": "Chasseur",
   "role": "Chasseur",
   "interpellations": [
    "Tu marches comme un sanglier.",
    "Les cerfs sont descendus de la crête. Mauvais signe.",
    "Ne va pas dans le bois seul à la nuit."
   ],
   "lignes": [
    "Une meute rôde entre le village et le cercle de pierres. Quatre bêtes, peut-être plus.",
    "Les cerfs se laissent approcher face au vent. Les loups, jamais.",
    "Dans la grotte, il y a des toiles larges comme des voiles. Je n’y retourne pas."
   ],
   "apres": [
    "Garde ta lame sèche.",
    "Si tu ramènes une peau de loup, Ylva t’en donnera un bon prix.",
    "Bonne chasse."
   ]
  },
  "chasseresse": {
   "nom": "Pisteuse",
   "role": "Pisteuse",
   "interpellations": [
    "Chut. Tu fais fuir le gibier jusqu’ici.",
    "Traces fraîches au nord. Pas de moi.",
    "Tu sais lire la neige ?"
   ],
   "lignes": [
    "Les loups chassent en meute : quand l’un te regarde, les autres te contournent.",
    "Le renard rôde près des granges. Il est plus malin que nous tous.",
    "Les araignées de la grotte tissent jusqu’au plafond. Prends du feu."
   ],
   "apres": [
    "Va doucement, et regarde où tu poses les pieds.",
    "Ylva est meilleure que moi. Ne lui dis pas.",
    "Que la neige couvre tes pas."
   ]
  }
 },
